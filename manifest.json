{
  "manifest_version": 3,
  "name": "HireHeat",
  "version": "2.0",
  "description": "Advanced LinkedIn job competition tracker - see application counts, trends, and find low-competition opportunities",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.linkedin.com/*"],
      "js": ["linkedin-tracker.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "HireHeat - Job Competition Tracker"
  },
  "background": {
    "service_worker": "background-simple.js"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["trends.html"],
      "matches": ["<all_urls>"]
    }
  ]
}